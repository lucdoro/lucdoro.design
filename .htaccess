# BEGIN WordPress
# Dyrektywy zawarte między „BEGIN WordPress” oraz „END WordPress” są generowane dynamicznie i powinny być modyfikowane tylko za pomocą
# filtrów WordPressa. Zmiany dokonane bezpośrednio tutaj będą nadpisywane.
<IfModule mod_rewrite.c>
DirectoryIndex index.html index.php
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# php -- BEGIN cPanel-generated handler, do not edit
# Nadaj pakietowi „alt-php82” status domyślnego języka programowania „PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Hotlink protection - ZABLOKUJ EMBED poza tymi domenami
# 1. Nowa domena lucdoro.design
RewriteCond %{HTTP_REFERER} !^http://lucdoro\.design/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://lucdoro\.design$      [NC]
RewriteCond %{HTTP_REFERER} !^https://lucdoro\.design/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://lucdoro\.design$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.lucdoro\.design/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.lucdoro\.design$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.lucdoro\.design/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.lucdoro\.design$      [NC]

# 2. Rochex.pl
RewriteCond %{HTTP_REFERER} !^http://rochex\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://rochex\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://rochex\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://rochex\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.rochex\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.rochex\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.rochex\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.rochex\.pl$      [NC]

# 3. Adresy techniczne serwera (xaa.pl i subdomeny serwerowe)
RewriteCond %{HTTP_REFERER} !^http://lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://rochex\.pl\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://rochex\.pl\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.rochex\.pl\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.rochex\.pl\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://rochex\.pl\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://rochex\.pl\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.lucdorodesign\.com\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.rochex\.pl\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.rochex\.pl\.serwer-lucdorodesign\.xaa\.pl$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.serwer-lucdorodesign\.xaa\.pl/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www\.serwer-lucdorodesign\.xaa\.pl$      [NC]

RewriteCond %{HTTP_REFERER} !^$
RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]

