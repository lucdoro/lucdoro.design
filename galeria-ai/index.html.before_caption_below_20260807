<script>
const BASE = 'https://lucdoro.design/assets/gallery';

// State
let MANIFEST = null;
let ACTIVE_FILTERS = { kategoria: 'all', postac: 'all', 'era-styl': 'all', realizm: 'all', is18: 'all' };
let currentIdx = 0;
let visibleFiles = [];

// Labels PL
const FACET_LABELS = {
  kategoria: 'Kategoria',
  postac: 'Postać',
  'era-styl': 'Era / Styl',
  realizm: 'Realizm',
  is18: 'Zawartość'
};

const VALUE_LABELS = {
  // kategoria
  'portret-kobiecy': 'Portret kobiecy',
  'moda-odziez': 'Moda / odzież',
  'logo-branding': 'Logo / branding',
  'tekstura-tlo': 'Tekstura',
  'produkt-render': 'Produkt render',
  'lifestyle-scena': 'Lifestyle',
  'koncept-abstrakt': 'Koncept',
  'bizuteria-detal': 'Biżuteria',
  'video-animacja': 'Video',
  'symbolika': 'Symbolika',
  // postac
  'marilyn-monroe-blonde': 'Marilyn Monroe',
  'brunette-glamour': 'Brunetka',
  'latina-beauty': 'Latina',
  'streetwear-model': 'Model streetwear',
  'abstract-figure': 'Abstract',
  'no-person': 'Brak osoby',
  'family-group': 'Rodzina',
  'animal-snake': 'Wąż',
  'animal-dog': 'Pies',
  // era-styl
  'vintage-1950s': 'Vintage 1950s',
  'retro-editorial': 'Retro editorial',
  'modern-minimal': 'Modern minimal',
  'timeless': 'Timeless',
  'y2k-nostalgic': 'Y2K',
  'industrial-brutalist': 'Industrial',
  'illustration-flat': 'Illustration',
  // realizm
  'hyperreal': 'Hyperreal',
  'cinematic': 'Cinematic',
  'editorial-photo': 'Editorial photo',
  'concept-art': 'Concept art',
  'stylized-illustration': 'Stylized illust.',
  'abstract-render': 'Abstract render',
};

function labelize(v){ return VALUE_LABELS[v] || v; }

async function loadManifest() {
  try {
    const res = await fetch(BASE + '/manifest.json?v=' + Date.now());
    MANIFEST = await res.json();
    buildFilters();
    renderGallery();
    document.getElementById('count-total').textContent = MANIFEST.total_files + ' grafik AI';
  } catch(e) {
    document.getElementById('gallery').innerHTML = '<div class="loading" style="color:#c73">Błąd ładowania manifestu: ' + e.message + '</div>';
  }
}

function countValues(facet) {
  const counts = {};
  for (const f of MANIFEST.files) {
    const v = facet === 'is18' ? (f['18plus'] ? 'y' : 'n') : f[facet];
    counts[v] = (counts[v] || 0) + 1;
  }
  return counts;
}

function buildFilters() {
  const wrap = document.getElementById('filters-wrap');
  const facets = ['kategoria', 'postac', 'era-styl', 'realizm', 'is18'];
  wrap.innerHTML = '';
  for (const facet of facets) {
    const counts = countValues(facet);
    const values = Object.keys(counts).sort((a,b) => counts[b] - counts[a]);
    const group = document.createElement('div');
    group.className = 'filter-group';
    group.innerHTML = `<div class="filter-group-label">${FACET_LABELS[facet]}</div><div class="filters" data-facet="${facet}"></div>`;
    const chipsWrap = group.querySelector('.filters');

    const allChip = document.createElement('button');
    allChip.className = 'chip is-active';
    allChip.dataset.value = 'all';
    allChip.innerHTML = `Wszystkie <span class="cnt">${MANIFEST.total_files}</span>`;
    chipsWrap.appendChild(allChip);

    for (const v of values) {
      const chip = document.createElement('button');
      chip.className = 'chip';
      chip.dataset.value = v;
      let display = v;
      if (facet === 'is18') display = v === 'y' ? '🔞 18+' : '✓ SFW';
      else display = labelize(v);
      chip.innerHTML = `${display} <span class="cnt">${counts[v]}</span>`;
      chipsWrap.appendChild(chip);
    }
    wrap.appendChild(group);
  }

  wrap.addEventListener('click', e => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const facet = chip.parentElement.dataset.facet;
    chip.parentElement.querySelectorAll('.chip').forEach(c => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    ACTIVE_FILTERS[facet] = chip.dataset.value;
    renderGallery();
  });
}

function passesFilters(f) {
  for (const [facet, val] of Object.entries(ACTIVE_FILTERS)) {
    if (val === 'all') continue;
    if (facet === 'is18') {
      const is18 = f['18plus'] ? 'y' : 'n';
      if (is18 !== val) return false;
    } else {
      if (f[facet] !== val) return false;
    }
  }
  return true;
}

function renderGallery() {
  const g = document.getElementById('gallery');
  visibleFiles = MANIFEST.files.filter(passesFilters);
  if (!visibleFiles.length) {
    g.innerHTML = '<div class="loading" style="grid-column:1/-1">Brak grafik dla wybranych filtrów.</div>';
    return;
  }
  g.innerHTML = visibleFiles.map((f, i) => {
    const isVideo = f.format === 'mp4';
    const badge18 = f['18plus'] ? '<span class="badge-18">18+</span>' : '';
    const badgeVid = isVideo ? '<span class="badge-video">▶ VIDEO</span>' : '';
    return `<div class="gallery-item" data-idx="${i}">
      <img class="img-base" src="${BASE}/painterly/${f.id}.webp" alt="${f.alt_pl}" loading="lazy" />
      <img class="img-sharp" src="${BASE}/thumbs/${f.id}.webp" alt="${f.alt_pl}" loading="lazy" crossorigin="anonymous" />
      <img class="tile-logo" src="https://lucdoro.design/assets/logo.png" alt="LucDoroDesign" loading="lazy" />
      ${badge18}
      ${badgeVid}
      <span class="tile-brand-tag">Galeria <em>AI</em></span>
    </div>`;
  }).join('');
  // Uruchom fotokomórkę na wszystkich sharp obrazkach (analiza brightness pod logiem)
  requestAnimationFrame(runPhotocellOnTiles);
}

// Fotokomórka: analizuje pixele w obszarze logo top-left (48x48px), ustawia .dark jeśli tło jasne
function runPhotocellOnTiles() {
  const tiles = document.querySelectorAll('.gallery-item');
  tiles.forEach(tile => {
    const sharp = tile.querySelector('.img-sharp');
    const logo = tile.querySelector('.tile-logo');
    if (!sharp || !logo || tile.dataset.pcelDone === '1') return;

    const analyze = () => {
      try {
        const cv = document.createElement('canvas');
        // sample 48x48 z top-left
        const sample = 48;
        cv.width = sample; cv.height = sample;
        const ctx = cv.getContext('2d');
        // narysuj tylko top-left część obrazu, skalowaną 1:1
        // sharp img ma naturalWidth/Height
        const nw = sharp.naturalWidth, nh = sharp.naturalHeight;
        if (!nw || !nh) return;
        // wycinamy prostokąt z lewej-górnej części odpowiadający pozycji loga
        // logo jest w pozycji 10-58px na kafelku, kafelek ~240px, obraz cover
        // uproszczenie: bierzemy top-left 15% x 15% obrazu
        const srcW = Math.floor(nw * 0.20), srcH = Math.floor(nh * 0.12);
        ctx.drawImage(sharp, 0, 0, srcW, srcH, 0, 0, sample, sample);
        const data = ctx.getImageData(0, 0, sample, sample).data;
        let sum = 0;
        for (let i = 0; i < data.length; i += 4) {
          // luminance: 0.299R + 0.587G + 0.114B
          sum += 0.299 * data[i] + 0.587 * data[i+1] + 0.114 * data[i+2];
        }
        const brightness = sum / (data.length / 4);
        // brightness < 128 → tło ciemne → logo białe (default)
        // brightness >= 128 → tło jasne → logo czarne (.dark)
        if (brightness >= 128) logo.classList.add('dark');
        else logo.classList.remove('dark');
        tile.dataset.pcelDone = '1';
      } catch(e) {
        // CORS albo inny błąd — zostaw default (białe)
        tile.dataset.pcelDone = '1';
      }
    };

    if (sharp.complete && sharp.naturalWidth) {
      analyze();
    } else {
      sharp.addEventListener('load', analyze, { once: true });
    }
  });
}

// Lightbox
const lb = document.getElementById('lightbox');
const lbImg = document.getElementById('lb-img');
const lbVid = document.getElementById('lb-video');
const lbTitle = document.getElementById('lb-title');
const lbDesc = document.getElementById('lb-desc');
const lbTags = document.getElementById('lb-tags');
const lbCounter = document.getElementById('lb-counter');

function openLightbox(idx) {
  currentIdx = idx;
  updateLb();
  lb.classList.add('is-open');
  document.body.style.overflow = 'hidden';
}
function updateLb() {
  const f = visibleFiles[currentIdx];
  if (!f) return;
  const isVideo = f.format === 'mp4';
  const lbLogo = document.getElementById('lb-logo');
  if (isVideo) {
    lbImg.style.display = 'none';
    lbVid.style.display = 'block';
    lbVid.src = BASE + '/video/' + f.id + '.mp4';
    lbVid.play().catch(()=>{});
  } else {
    lbVid.pause();
    lbVid.style.display = 'none';
    lbImg.style.display = 'block';
    lbImg.src = BASE + '/full/' + f.id + '.webp';
    lbImg.alt = f.alt_pl;
    lbImg.addEventListener('load', () => runPhotocellOnLightbox(lbImg, lbLogo), { once: true });
  }
  lbTitle.textContent = f.title_pl;
  lbDesc.textContent = f.alt_pl;
  lbCounter.textContent = (currentIdx + 1) + ' / ' + visibleFiles.length;
  // tags clickable — kategoria, postać, era-styl, realizm, mood + motywy top 3
  const facetTags = [
    ['kategoria', f.kategoria],
    ['postac', f.postac],
    ['era-styl', f['era-styl']],
    ['realizm', f.realizm],
    ['mood', f.mood],
  ].filter(([_, v]) => v && v !== 'no-person');
  lbTags.innerHTML = facetTags.map(([facet, v]) =>
    `<span class="lb-tag-mini" data-facet="${facet}" data-value="${v}">${labelize(v)}</span>`
  ).join('');
}

// Fotokomórka dla lightbox — analiza brightness top-left
function runPhotocellOnLightbox(img, logo) {
  if (!img || !logo || !img.naturalWidth) return;
  try {
    const cv = document.createElement('canvas');
    const sample = 60;
    cv.width = sample; cv.height = sample;
    const ctx = cv.getContext('2d');
    const nw = img.naturalWidth, nh = img.naturalHeight;
    const srcW = Math.floor(nw * 0.15), srcH = Math.floor(nh * 0.10);
    ctx.drawImage(img, 0, 0, srcW, srcH, 0, 0, sample, sample);
    const data = ctx.getImageData(0, 0, sample, sample).data;
    let sum = 0;
    for (let i = 0; i < data.length; i += 4) {
      sum += 0.299 * data[i] + 0.587 * data[i+1] + 0.114 * data[i+2];
    }
    const b = sum / (data.length / 4);
    if (b >= 128) logo.classList.add('dark');
    else logo.classList.remove('dark');
  } catch(e) {
    logo.classList.remove('dark');
  }
}
function closeLightbox() {
  lb.classList.remove('is-open');
  lbVid.pause();
  document.body.style.overflow = '';
}
function nav(delta) {
  if (!visibleFiles.length) return;
  currentIdx = (currentIdx + delta + visibleFiles.length) % visibleFiles.length;
  updateLb();
}

document.getElementById('gallery').addEventListener('click', e => {
  const item = e.target.closest('.gallery-item');
  if (item) openLightbox(+item.dataset.idx);
});
// Click na tag w lightbox → aktywuj filtr + zamknij + scroll do galerii
document.getElementById('lb-tags').addEventListener('click', e => {
  const tag = e.target.closest('.lb-tag-mini');
  if (!tag) return;
  const facet = tag.dataset.facet;
  const value = tag.dataset.value;
  if (!facet || !value) return;
  // Ustaw filtr
  ACTIVE_FILTERS[facet] = value;
  // Odzwierciedl aktywny chip w UI filterów
  const wrap = document.getElementById('filters-wrap');
  const groupChips = wrap.querySelector(`.filters[data-facet="${facet}"]`);
  if (groupChips) {
    groupChips.querySelectorAll('.chip').forEach(c => c.classList.remove('is-active'));
    const activeChip = groupChips.querySelector(`.chip[data-value="${value}"]`);
    if (activeChip) activeChip.classList.add('is-active');
  }
  closeLightbox();
  renderGallery();
  // Scroll do galerii
  document.getElementById('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' });
});
document.getElementById('lb-close').addEventListener('click', closeLightbox);
lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
document.getElementById('lb-prev').addEventListener('click', e => { e.stopPropagation(); nav(-1); });
document.getElementById('lb-next').addEventListener('click', e => { e.stopPropagation(); nav(1); });
document.addEventListener('keydown', e => {
  if (!lb.classList.contains('is-open')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') nav(-1);
  if (e.key === 'ArrowRight') nav(1);
});

loadManifest();
</script>
