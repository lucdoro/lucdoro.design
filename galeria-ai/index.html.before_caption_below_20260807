<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Galeria AI — 171 grafik Midjourney · LucDoroDesign</title>
<meta name="description" content="Galeria fotorealistycznych grafik AI (171 sztuk) — portrety Marilyn Monroe, moda streetwear, tekstury, koncepcje. Efekt malarski przechodzi w ostrą wersję po najechaniu.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@1,9..144,400..700&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0d0d10;--panel:#161619;--line:#2b2b32;--txt:#f2efe8;--mut:#a09a91;--acc:#b58cff;--acc2:#7b4dff;--ok:#1DB954;}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{overflow-x:hidden;}
body{background:var(--bg);color:var(--txt);font-family:'Manrope',sans-serif;min-height:100vh;line-height:1.5;}
a{color:inherit;}
button{font-family:inherit;cursor:pointer;}

/* HEADER — spójny z lucdoro.design */
.header{position:sticky;top:0;z-index:100;background:color-mix(in srgb, var(--bg) 62%, transparent);backdrop-filter:blur(32px) saturate(160%);-webkit-backdrop-filter:blur(32px) saturate(160%);border-bottom:1px solid rgba(255,255,255,.08);}
.header-bg-title{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-start;padding-left:clamp(180px,22vw,360px);font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:clamp(3rem,8vw,7.5rem);letter-spacing:-.04em;line-height:1.05;color:transparent;-webkit-text-stroke:1px var(--acc);pointer-events:none;user-select:none;z-index:0;opacity:.3;white-space:nowrap;overflow:hidden}
.header-bg-title em{font-style:italic;font-weight:600;-webkit-text-stroke:1px var(--acc2);}
.nav{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 24px;min-height:160px;max-width:1600px;margin:0 auto;}
.brand-wrap{display:inline-flex;align-items:center;gap:16px;text-decoration:none;color:var(--txt);flex-shrink:0;}
.brand-logo{height:76px;width:auto;display:block;object-fit:contain;flex-shrink:0;}
@media(max-width:768px){.brand-logo{height:64px;}}
@media(max-width:480px){.brand-logo{height:56px;}}
.nav-links{display:flex;flex-direction:column;gap:6px;align-items:center;font-size:13px;}
.nav-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:center;}
.nav-links a{position:relative;color:var(--txt);text-decoration:none;padding:8px 14px;border-radius:999px;overflow:hidden;transition:color .3s;isolation:isolate;font-weight:600;text-shadow:0 1px 3px rgba(0,0,0,.5);}
.nav-links a::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,var(--acc2),var(--acc));transform:translateY(101%);transition:transform .35s cubic-bezier(.7,0,.3,1);z-index:-1;border-radius:999px;}
.nav-links a:hover{color:#fff;}
.nav-links a:hover::before{transform:translateY(0);}
.nav-back{color:var(--txt);border:1px solid rgba(255,255,255,.2);padding:6px 12px;border-radius:999px;text-decoration:none;font-size:12px;font-weight:600;transition:border-color .2s,color .2s;}
.nav-back:hover{border-color:var(--acc);color:var(--acc);}
@media(max-width:840px){
  .nav{flex-wrap:wrap;min-height:auto;padding:12px 16px;gap:12px;}
  .nav-links{flex-direction:row;flex-wrap:wrap;order:3;width:100%;}
  .nav-row{width:100%;}
  .header-bg-title{font-size:clamp(3rem,15vw,6rem);opacity:.1;}
}

/* HERO */
.hero{padding:56px 32px 24px;text-align:center;max-width:960px;margin:0 auto;position:relative;}
.hero .kicker{font-family:'Roboto Mono',monospace;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--acc);margin-bottom:16px;}
.hero h1{font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:clamp(32px,5vw,58px);line-height:1.1;letter-spacing:-.02em;margin-bottom:14px;background:linear-gradient(135deg,#f2efe8,#b58cff);-webkit-background-clip:text;background-clip:text;color:transparent;}
.hero p{color:var(--mut);font-size:15px;max-width:640px;margin:0 auto 16px;line-height:1.65;}
.hero .count{display:inline-block;background:linear-gradient(135deg,var(--acc2),var(--acc));color:#fff;padding:6px 14px;border-radius:99px;font-family:'Roboto Mono',monospace;font-size:11px;letter-spacing:2px;font-weight:700;}

/* FILTERS — facet chips */
.filters-wrap{padding:8px 24px 24px;max-width:1600px;margin:0 auto;}
.filter-group{margin-bottom:14px;}
.filter-group-label{font-family:'Roboto Mono',monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--mut);margin-bottom:8px;padding-left:2px;}
.filters{display:flex;flex-wrap:wrap;gap:6px;}
.chip{position:relative;padding:6px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:transparent;color:var(--mut);font-family:'Roboto Mono',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;overflow:hidden;transition:color .3s,border-color .3s;isolation:isolate;cursor:pointer;font-weight:600;}
.chip::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,var(--acc2),var(--acc));transform:translateY(101%);transition:transform .35s cubic-bezier(.7,0,.3,1);z-index:-1;}
.chip:hover{color:#fff;border-color:transparent;}
.chip:hover::before{transform:translateY(0);}
.chip.is-active{color:#fff;border-color:transparent;box-shadow:0 0 0 2px var(--acc),0 0 20px -4px rgba(181,140,255,.5);}
.chip.is-active::before{transform:translateY(0);}
.chip .cnt{opacity:.7;margin-left:4px;font-weight:400;}

/* Gallery grid */
.gallery{padding:20px 24px 80px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;max-width:1600px;margin:0 auto;}
@media(max-width:800px){.gallery{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;padding:20px 14px 60px;}}
.gallery-item{margin:0;position:relative;border-radius:14px;overflow:hidden;cursor:zoom-in;transition:transform .4s cubic-bezier(.22,1,.36,1),box-shadow .4s ease,opacity .3s ease;background:#14141a;aspect-ratio:9/16;}
.gallery-item.is-hidden{display:none;}
.gallery-item:hover{transform:translateY(-3px) scale(1.005);box-shadow:0 20px 40px -20px rgba(0,0,0,.6),0 0 0 2px var(--acc),0 0 24px -4px rgba(181,140,255,.4);}
/* Dual img: painterly base + sharp overlay (opacity 0→1 on hover) */
.gallery-item .img-base,.gallery-item .img-sharp{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .5s ease,transform .6s cubic-bezier(.22,1,.36,1);}
.gallery-item .img-base{opacity:1;}
.gallery-item .img-sharp{opacity:0;}
.gallery-item:hover .img-base{opacity:0;}
.gallery-item:hover .img-sharp{opacity:1;transform:scale(1.04);}
.gallery-item::after{content:"⌕";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.6);width:44px;height:44px;background:linear-gradient(135deg,var(--acc2),var(--acc));border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;opacity:0;transition:opacity .3s ease,transform .3s cubic-bezier(.34,1.56,.64,1);pointer-events:none;box-shadow:0 6px 18px -4px rgba(123,77,255,.6);z-index:3;}
.gallery-item:hover::after{opacity:1;transform:translate(-50%,-50%) scale(1);}
/* LOGO top-left — fotokomórka auto-invert */
.gallery-item .tile-logo{position:absolute;top:10px;left:10px;width:38px;height:38px;object-fit:contain;z-index:3;pointer-events:none;transition:filter .4s ease,opacity .3s ease;opacity:.92;filter:brightness(0) invert(1) drop-shadow(0 1px 3px rgba(0,0,0,.5));}
.gallery-item .tile-logo.dark{filter:brightness(0) invert(0) drop-shadow(0 1px 3px rgba(255,255,255,.4));}
@media(max-width:500px){.gallery-item .tile-logo{width:30px;height:30px;top:8px;left:8px;}}
/* BRAND TAG bottom-right — Fraunces outline "Galeria AI" jak w headerze */
.gallery-item .tile-brand-tag{position:absolute;bottom:10px;right:12px;font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:15px;letter-spacing:-.02em;line-height:1;color:transparent;-webkit-text-stroke:.6px var(--acc);z-index:2;pointer-events:none;user-select:none;filter:drop-shadow(0 1px 3px rgba(0,0,0,.7));white-space:nowrap;}
.gallery-item .tile-brand-tag em{font-style:italic;font-weight:600;-webkit-text-stroke:.6px var(--acc2);}
@media(max-width:500px){.gallery-item .tile-brand-tag{font-size:12px;bottom:8px;right:10px;}}
/* Badge 18+ / VIDEO — dolny lewy */
.gallery-item .badge-18{position:absolute;bottom:10px;left:10px;padding:3px 8px;border-radius:6px;background:rgba(200,40,40,.9);color:#fff;font-family:'Roboto Mono',monospace;font-size:9px;font-weight:800;letter-spacing:.5px;z-index:2;}
.gallery-item .badge-video{position:absolute;top:10px;right:10px;padding:3px 8px;border-radius:6px;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);color:#fff;font-family:'Roboto Mono',monospace;font-size:9px;font-weight:700;letter-spacing:.8px;z-index:2;}

/* Lightbox — obraz w kontenerze z overlayami (logo, brand, opis flush) */
.lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.94);backdrop-filter:blur(20px);z-index:200;padding:40px;align-items:center;justify-content:center;cursor:zoom-out;}
.lightbox.is-open{display:flex;animation:lbFade .3s ease;}
@keyframes lbFade{from{opacity:0;}to{opacity:1;}}
/* Wrapper obrazu — position:relative, sized do rzeczywistych wymiarów obrazu przez JS */
.lb-image-wrap{position:relative;display:inline-block;max-width:calc(100vw - 120px);max-height:calc(100vh - 100px);border-radius:8px;overflow:hidden;box-shadow:0 30px 100px rgba(0,0,0,.6),0 0 0 1px rgba(181,140,255,.2);cursor:default;}
.lb-media{display:block;max-width:calc(100vw - 120px);max-height:calc(100vh - 100px);object-fit:contain;border-radius:8px;}
/* LOGO top-left overlay w obrazie */
.lb-logo-overlay{position:absolute;top:14px;left:14px;width:52px;height:52px;object-fit:contain;z-index:5;pointer-events:none;transition:filter .4s ease;filter:brightness(0) invert(1) drop-shadow(0 1px 4px rgba(0,0,0,.6));opacity:.95;}
.lb-logo-overlay.dark{filter:brightness(0) invert(0) drop-shadow(0 1px 4px rgba(255,255,255,.5));}
@media(max-width:640px){.lb-logo-overlay{width:40px;height:40px;top:10px;left:10px;}}
/* BRAND TAG "Galeria AI" — bottom-right overlay w obrazie */
.lb-brand-overlay{position:absolute;bottom:60px;right:16px;font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:22px;letter-spacing:-.02em;line-height:1;color:transparent;-webkit-text-stroke:.8px var(--acc);z-index:5;pointer-events:none;user-select:none;filter:drop-shadow(0 1px 4px rgba(0,0,0,.8));white-space:nowrap;}
.lb-brand-overlay em{font-style:italic;font-weight:600;-webkit-text-stroke:.8px var(--acc2);}
@media(max-width:640px){.lb-brand-overlay{font-size:16px;bottom:50px;right:12px;}}
/* OPIS STRIP — flush do dolnej krawędzi obrazu */
.lb-desc-strip{position:absolute;left:0;right:0;bottom:0;padding:16px 20px 12px;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.55) 40%,rgba(0,0,0,.92) 100%);z-index:4;pointer-events:auto;}
.lb-desc-strip .lb-title{display:block;font-family:'Manrope',sans-serif;font-size:15px;line-height:1.35;color:#f2efe8;font-weight:700;letter-spacing:.1px;text-shadow:0 1px 4px rgba(0,0,0,.9);margin-bottom:4px;}
.lb-desc-strip .lb-desc{display:block;font-family:'Manrope',sans-serif;font-size:12px;line-height:1.5;color:#d8d3ca;font-weight:400;letter-spacing:.1px;text-shadow:0 1px 3px rgba(0,0,0,.8);margin-bottom:8px;}
.lb-desc-strip .lb-tags{display:flex;flex-wrap:wrap;gap:5px;}
.lb-tag-mini{font-family:'Roboto Mono',monospace;font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:4px 9px;background:rgba(181,140,255,.18);border:1px solid rgba(181,140,255,.4);border-radius:99px;color:var(--acc);cursor:pointer;transition:all .2s;font-weight:600;}
.lb-tag-mini:hover{background:linear-gradient(135deg,var(--acc2),var(--acc));border-color:transparent;color:#fff;transform:translateY(-1px);box-shadow:0 4px 12px -2px rgba(123,77,255,.5);}
@media(max-width:640px){
  .lb-desc-strip{padding:12px 14px 10px;}
  .lb-desc-strip .lb-title{font-size:13px;}
  .lb-desc-strip .lb-desc{font-size:11px;}
  .lb-tag-mini{font-size:8px;padding:3px 7px;}
}
/* Nawigacja / zamknięcie */
.lb-close,.lb-nav{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:50%;cursor:pointer;transition:all .25s;line-height:1;}
.lb-close{position:absolute;top:20px;right:20px;width:44px;height:44px;font-size:20px;z-index:220;}
.lb-close:hover{background:rgba(255,255,255,.2);transform:rotate(90deg);border-color:var(--acc);}
.lb-nav{position:absolute;top:50%;transform:translateY(-50%);width:52px;height:52px;font-size:22px;z-index:220;}
.lb-nav:hover{background:linear-gradient(135deg,var(--acc2),var(--acc));border-color:transparent;box-shadow:0 8px 24px -6px rgba(123,77,255,.6);}
.lb-prev{left:20px;} .lb-next{right:20px;}
.lb-counter{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);color:#fff;font-family:'Roboto Mono',monospace;font-size:12px;letter-spacing:2px;background:rgba(0,0,0,.5);padding:5px 12px;border-radius:99px;border:1px solid rgba(255,255,255,.15);z-index:220;}
@media(max-width:640px){
  .lightbox{padding:16px;}
  .lb-nav{width:40px;height:40px;font-size:18px;}
  .lb-prev{left:8px;}.lb-next{right:8px;}
  .lb-media,.lb-image-wrap{max-width:calc(100vw - 24px);max-height:calc(100vh - 80px);}
}

footer{padding:40px 24px;text-align:center;color:var(--mut);font-size:12px;border-top:1px solid rgba(255,255,255,.06);}
footer a{color:var(--acc);text-decoration:none;}

/* Loading state */
.loading{padding:60px;text-align:center;color:var(--mut);font-family:'Roboto Mono',monospace;font-size:12px;letter-spacing:2px;}
</style>
</head>
