<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title data-i18n-en="Developer — homegrown tools · LucDoroDesign">Developer — autorskie narzędzia · LucDoroDesign</title>
<meta data-i18n-en="Original apps and tools by LucDoroDesign — YT Whisper (local transcription), GPT Mode Panel, Unlimited Portal, Thought Visualizer." data-i18n-attr="content" name="description" content="Autorskie aplikacje i narzędzia LucDoroDesign — YT Whisper (lokalna transkrypcja), GPT Mode Panel, Unlimited Portal, Thought Visualizer.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Syne:wght@600;700;800&family=Playfair+Display:wght@600;700&family=Roboto+Mono:wght@500;700&family=Fraunces:ital,opsz,wght@1,9..144,400..700&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  :root{--acc:#b58cff;--acc2:#1DB954;--bg:#0d0d10;--card:#161619;--line:#2b2b32;--txt:#f2efe8;--mut:#a09a91;}
  html{overflow-x:hidden;max-width:100vw;}
  body{background:var(--bg);color:var(--txt);font-family:'Manrope',system-ui,Arial,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.5;overflow-x:hidden;max-width:100vw;cursor:default;-webkit-user-select:none;user-select:none;}
  input,textarea,select,[contenteditable="true"]{cursor:text;-webkit-user-select:text;user-select:text;}
  a,button,label,summary,[role="button"],[role="tab"],[role="menuitem"]{cursor:pointer;}
  ::selection{background:transparent;}
  ::-moz-selection{background:transparent;}
  *{max-width:100%;box-sizing:border-box;}
  a{color:inherit;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}

  /* TOP NAV — spójny z /stopki-mailowe/ */
  .top-nav{position:sticky;top:0;z-index:100;background:rgba(13,13,16,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.1);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;color:#f2efe8;}
  .top-nav *{color:#f2efe8;}
  .top-nav-back{display:inline-flex;align-items:center;gap:8px;color:#f2efe8;text-decoration:none;font-size:14px;font-weight:600;padding:8px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.25);transition:all .2s ease;}
  .top-nav-back:hover{border-color:#b58cff;color:#b58cff;transform:translateX(-2px);}
  .top-nav-brand{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;color:#f2efe8;letter-spacing:.02em;}
  .top-nav-links{display:flex;gap:14px;align-items:center;font-size:13px;}
  .top-nav-links a{color:#a09a91;text-decoration:none;transition:color .2s;}
  .top-nav-links a:hover{color:#b58cff;}
  .tn-btn{background:transparent;border:1px solid rgba(255,255,255,.2);color:#f2efe8;width:36px;height:36px;border-radius:999px;cursor:pointer;font-size:15px;display:inline-flex;align-items:center;justify-content:center;transition:all .2s;}
  .tn-btn:hover{border-color:#b58cff;color:#b58cff;}
  .tn-lang-btn{width:auto;padding:0 10px;font-family:'Roboto Mono',monospace;font-size:11px;font-weight:700;letter-spacing:1.5px;}
  .tn-palette-wrap{position:relative;display:inline-block;}
  .tn-palette-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:200px;background:#1a1a1e;border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:6px;display:none;flex-direction:column;gap:2px;box-shadow:0 20px 50px -20px rgba(0,0,0,.5);z-index:200;}
  .tn-palette-menu.is-open{display:flex;}
  .tn-palette-menu button{background:transparent;border:0;color:#f2efe8;padding:9px 12px;border-radius:9px;cursor:pointer;font-family:inherit;font-size:13px;text-align:left;display:flex;align-items:center;gap:10px;transition:background .18s;}
  .tn-palette-menu button:hover{background:rgba(255,255,255,.06);}
  .tn-palette-menu button.is-active{background:color-mix(in srgb, var(--acc) 15%, transparent);color:#b58cff;}
  .tn-swatches{display:inline-flex;gap:3px;}
  .tn-swatches span{width:14px;height:14px;border-radius:50%;border:1px solid rgba(0,0,0,.15);}
  @media(max-width:640px){.top-nav{padding:10px 16px;}.top-nav-brand{display:none;}.top-nav-links{gap:10px;font-size:12px;}.tn-palette-menu{position:fixed;top:auto;bottom:14px;left:14px;right:14px;min-width:0;}}

  /* HERO */
  .hero{padding:80px 0 56px;text-align:center;position:relative;overflow:hidden;}
  .hero::before{content:"";position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:680px;height:420px;background:radial-gradient(closest-side,color-mix(in srgb, var(--acc) 22%, transparent),transparent);filter:blur(10px);z-index:0;}
  .hero>*{position:relative;z-index:1;}
  .bg-outline{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Fraunces','Playfair Display',serif;font-style:italic;font-weight:400;font-size:clamp(8rem,22vw,20rem);color:var(--bg);letter-spacing:-.04em;line-height:.85;z-index:0;pointer-events:none;user-select:none;white-space:nowrap;opacity:1;}
  @media(max-width:640px){.bg-outline{font-size:clamp(4rem,28vw,8rem);}}
  .hero>*:not(.bg-outline){position:relative;z-index:2;}
  /* MLECZNE SZKLO — tafla pod trescia hero, bez ramek */
  .hero .wrap>*:not(.bg-outline){position:relative;z-index:1;}
  .hero .wrap{position:relative;z-index:2;overflow:hidden;border-radius:30px;padding-top:34px;padding-bottom:38px;
    background:rgba(255,255,255,.07);
    -webkit-backdrop-filter:blur(20px) saturate(130%);backdrop-filter:blur(20px) saturate(130%);}
  [data-theme="light"] .hero .wrap{background:rgba(255,255,255,.58);}
  @media(max-width:640px){.hero .wrap{border-radius:22px;padding-top:26px;padding-bottom:28px;}}
  .kicker{font-family:'Roboto Mono',monospace;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--acc);margin-bottom:20px;}
  h1{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(32px,5vw,58px);line-height:1.05;letter-spacing:-.5px;}
  h1 em{font-style:italic;color:var(--acc2);font-family:'Playfair Display',serif;font-weight:700;}
  .lead{max-width:640px;margin:22px auto 0;color:var(--mut);font-size:17px;}
  .cta-row{margin-top:34px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;align-items:center;}
  .btn{display:inline-block;text-decoration:none;font-weight:700;font-size:14px;letter-spacing:.3px;padding:14px 24px;border-radius:14px;transition:transform .15s ease,box-shadow .15s ease;}
  .btn:hover{transform:translateY(-2px);}
  .btn-wa{background:#25d366;color:#04220f;box-shadow:0 8px 30px rgba(37,211,102,.35);}
  .btn-olx{background:transparent;color:var(--txt);border:1px solid var(--line);}
  .btn-olx:hover{border-color:var(--acc);}
  .price-pill{display:inline-flex;align-items:center;gap:8px;font-family:'Roboto Mono',monospace;font-size:13px;font-weight:700;color:var(--acc);border:1px solid color-mix(in srgb, var(--acc) 40%, transparent);border-radius:999px;padding:10px 16px;background:color-mix(in srgb, var(--acc) 8%, transparent);}

  /* SECTION */
  .sec-head{text-align:center;margin:72px 0 8px;}
  .sec-head h2{font-family:'Syne',sans-serif;font-weight:700;font-size:clamp(24px,3.5vw,36px);}
  .sec-head p{color:var(--mut);margin-top:10px;}

  /* APP GRID — 2 kolumny jak stopki */
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;margin-top:40px;}
  @media(max-width:820px){.grid{grid-template-columns:1fr;}}

  .ex-wrap{display:flex;flex-direction:column;gap:10px;}
  .ex{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:0;overflow:hidden;transition:transform .3s cubic-bezier(.22,1,.36,1),border-color .3s;text-decoration:none;color:inherit;display:flex;flex-direction:column;}
  .ex.is-live:hover{transform:translateY(-3px);border-color:rgba(29,185,84,.4);}
  .ex.is-soon{cursor:default;opacity:.85;}
  .ex.is-soon:hover{border-color:color-mix(in srgb, var(--acc) 35%, transparent);}
  .ex-top{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 22px 0;}
  .ex-tag{font-family:'Roboto Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mut);}
  .ex-no{font-family:'Roboto Mono',monospace;font-size:11px;color:var(--acc);font-weight:700;}
  .ex-stage{padding:22px 22px 24px;display:flex;flex-direction:column;gap:14px;flex:1;}
  .ex-title{font-family:'Syne',sans-serif;font-weight:800;font-size:26px;letter-spacing:-.02em;line-height:1.1;color:var(--txt);}
  .ex-title em{font-style:italic;color:var(--acc);font-family:'Playfair Display',serif;font-weight:700;}
  .ex-desc{color:var(--mut);font-size:14px;line-height:1.6;flex:1;}
  .ex-desc b{color:var(--txt);font-weight:600;}
  .ex-meta{font-family:'Roboto Mono',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mut);padding-top:12px;border-top:1px dashed rgba(255,255,255,.08);display:flex;flex-wrap:wrap;gap:12px;}
  .ex-meta span{display:inline-flex;align-items:center;gap:5px;}
  .ex-meta b{color:var(--acc);font-weight:700;}
  .ex-note{font-family:'Manrope',sans-serif;font-size:12.5px;color:var(--mut);line-height:1.55;padding:0 4px;text-align:center;font-style:italic;}
  .ex-status{display:inline-flex;align-items:center;gap:8px;font-family:'Roboto Mono',monospace;font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:5px 11px;border-radius:999px;}
  .ex-status.live{color:#04220f;background:#25d366;box-shadow:0 4px 16px rgba(37,211,102,.35);}
  .ex-status.live::before{content:"";width:6px;height:6px;border-radius:50%;background:#04220f;animation:pulse 2s ease-in-out infinite;}
  .ex-status.soon{color:var(--mut);border:1px solid var(--line);}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}
  .ex-cta{display:inline-flex;align-items:center;gap:6px;font-family:'Roboto Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--acc);font-weight:700;transition:transform .2s;margin-top:4px;}
  .ex.is-live:hover .ex-cta{transform:translateX(3px);}

  /* PALETY dla subpage (spójne z stopki) */
  :root[data-palette="combo01"][data-theme="light"]{--bg:#CAE8E8;--card:#DEF0F0;--line:#A0C4C4;--txt:#28469E;--mut:#4864B0;--acc:#28469E;;--acc2:#E5555C;}
  :root[data-palette="combo01"][data-theme="dark"]{--bg:#28469E;--card:#334FA8;--line:#4260B4;--txt:#CAE8E8;--mut:#A0C4C4;--acc:#CAE8E8;;--acc2:#FF7B85;}
  :root[data-palette="combo02"][data-theme="light"]{--bg:#FDE1B8;--card:#FFEDD5;--line:#E8CCA0;--txt:#3A241C;--mut:#7A5A48;--acc:#C24A2E;;--acc2:#7A1E5C;}
  :root[data-palette="combo02"][data-theme="dark"]{--bg:#3E0856;--card:#4E1866;--line:#6E3886;--txt:#FAAE62;--mut:#E09E52;--acc:#FAAE62;;--acc2:#00E5A0;}
  :root[data-palette="combo03"][data-theme="light"]{--bg:#B0EDF9;--card:#C4F0F9;--line:#88C4D8;--txt:#04344C;--mut:#24546C;--acc:#04344C;;--acc2:#E67E22;}
  :root[data-palette="combo03"][data-theme="dark"]{--bg:#04344C;--card:#14546C;--line:#2A5A72;--txt:#B0EDF9;--mut:#88CDE0;--acc:#B0EDF9;;--acc2:#FFB74D;}
  :root[data-palette="combo04"][data-theme="light"]{--bg:#F5EDEF;--card:#FAF3F5;--line:#E5D0D6;--txt:#3A0F1D;--mut:#7A5060;--acc:#7A1E5C;;--acc2:#3D7A4A;}
  :root[data-palette="combo04"][data-theme="dark"]{--bg:#2A0F1A;--card:#3A1826;--line:#4A2536;--txt:#F5EDEF;--mut:#B89AA8;--acc:#D07DAD;;--acc2:#5DAA6F;}
  :root[data-palette="combo05"][data-theme="light"]{--bg:#FFFE15;--card:#FFFF3C;--line:#D0CE10;--txt:#0C1E29;--mut:#243E49;--acc:#0C1E29;;--acc2:#D9186B;}
  :root[data-palette="combo05"][data-theme="dark"]{--bg:#0C1E29;--card:#182E39;--line:#3E5E69;--txt:#FFFE15;--mut:#E0DE35;--acc:#FFFE15;;--acc2:#FF3A9E;}
  :root[data-theme="light"]:not([data-palette]){--bg:#f5f2ea;--card:#ffffff;--line:#e4dfd0;--txt:#1a1a1e;--mut:#5a554d;--acc:#7b4dff;--acc2:#1DB954;}

  footer{padding:44px 24px 40px;text-align:center;color:var(--mut);font-size:12px;border-top:1px solid rgba(255,255,255,.06);margin-top:60px;font-family:'Roboto Mono',monospace;letter-spacing:1.5px;text-transform:uppercase;}
  footer a{color:var(--acc);text-decoration:none;font-weight:700;}
  footer a:hover{text-decoration:underline;}
</style>
</head>
