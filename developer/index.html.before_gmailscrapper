<script>
/* PARALLAX na bg-outline — kursor + scroll z lerpem (płynne) */
(function(){
  var el = document.querySelector('.bg-outline');
  if (!el || !('requestAnimationFrame' in window)) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var mx=0, my=0, sy=0;         // target
  var cx=0, cy=0, csy=0;        // current (lerped)
  var running = false;
  function tick(){
    cx  += (mx  - cx)  * 0.08;
    cy  += (my  - cy)  * 0.08;
    csy += (sy  - csy) * 0.12;
    var tx = cx * 32;                       // ±32px z ruchu myszy
    var ty = cy * 22 + csy * 0.4;           // ±22px myszy + 40% scrolla
    el.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0)';
    if (Math.abs(mx-cx)>.001 || Math.abs(my-cy)>.001 || Math.abs(sy-csy)>.5){
      requestAnimationFrame(tick);
    } else { running = false; }
  }
  function start(){ if (!running){ running = true; requestAnimationFrame(tick); } }
  el.style.willChange = 'transform';
  window.addEventListener('mousemove', function(e){
    mx = (e.clientX / window.innerWidth  - 0.5) * 2;
    my = (e.clientY / window.innerHeight - 0.5) * 2;
    start();
  }, {passive:true});
  window.addEventListener('scroll', function(){
    sy = window.scrollY;
    start();
  }, {passive:true});
  sy = window.scrollY; start();
})();

/* PALETTE + THEME sync z lucdoro.design */
/* EN/PL toggle — swap html[lang] i wszystkie elementy z data-i18n-en */
(function(){
  var btn = document.getElementById('tn-lang-btn');
  if (!btn) return;
  var html = document.documentElement;
  var STORAGE = 'lucdoro-lang';
  var nodes = document.querySelectorAll('[data-i18n-en]');

  // Zapamiętaj polski oryginał (innerHTML albo atrybut) przy pierwszym uruchomieniu
  nodes.forEach(function(el){
    if (el.getAttribute('data-i18n-pl') !== null) return;
    var attr = el.getAttribute('data-i18n-attr');
    el.setAttribute('data-i18n-pl', attr ? (el.getAttribute(attr) || '') : el.innerHTML);
  });

  function apply(lang){
    html.setAttribute('lang', lang);
    btn.textContent = lang === 'en' ? 'PL' : 'EN';
    btn.setAttribute('aria-label', lang === 'en' ? 'Zmień język na polski' : 'Change language to English');
    nodes.forEach(function(el){
      var val = lang === 'en' ? el.getAttribute('data-i18n-en') : el.getAttribute('data-i18n-pl');
      if (val === null) return;
      var attr = el.getAttribute('data-i18n-attr');
      if (attr) el.setAttribute(attr, val); else el.innerHTML = val;
    });
    try { localStorage.setItem(STORAGE, lang); } catch(e){}
  }

  var saved = 'pl';
  try { saved = localStorage.getItem(STORAGE) || 'pl'; } catch(e){}
  apply(saved);
  btn.addEventListener('click', function(){
    apply(html.getAttribute('lang') === 'en' ? 'pl' : 'en');
  });
})();

(function(){
  var STORAGE_PAL = 'lucdoro-palette';
  var STORAGE_THEME = 'theme';
  var html = document.documentElement;
  var themeBtn = document.getElementById('tn-theme-btn');
  var palBtn = document.getElementById('tn-palette-btn');
  var palMenu = document.getElementById('tn-palette-menu');
  if (!themeBtn || !palBtn || !palMenu) return;
  var palChips = palMenu.querySelectorAll('button');

  function applyTheme(t){
    html.setAttribute('data-theme', t);
    themeBtn.textContent = t === 'dark' ? '☾' : '☀';
    try { localStorage.setItem(STORAGE_THEME, t); } catch(e){}
  }
  function applyPal(p){
    if (p && p !== 'default'){ html.setAttribute('data-palette', p); }
    else { html.removeAttribute('data-palette'); p = 'default'; }
    palChips.forEach(function(c){ c.classList.toggle('is-active', c.dataset.palette === p); });
    try { localStorage.setItem(STORAGE_PAL, p); } catch(e){}
  }

  var savedTheme = 'dark', savedPal = 'default';
  try { savedTheme = localStorage.getItem(STORAGE_THEME) || 'dark'; } catch(e){}
  try { savedPal   = localStorage.getItem(STORAGE_PAL)   || 'default'; } catch(e){}
  applyTheme(savedTheme);
  applyPal(savedPal);

  themeBtn.addEventListener('click', function(){
    applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });
  palBtn.addEventListener('click', function(e){
    e.stopPropagation();
    var open = palMenu.classList.toggle('is-open');
    palBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', function(e){
    if (!palMenu.contains(e.target) && e.target !== palBtn){
      palMenu.classList.remove('is-open');
      palBtn.setAttribute('aria-expanded', 'false');
    }
  });
  palChips.forEach(function(c){
    c.addEventListener('click', function(){
      applyPal(c.dataset.palette);
      palMenu.classList.remove('is-open');
      palBtn.setAttribute('aria-expanded', 'false');
    });
  });
})();
</script>

